{
  "name": "react-native-simple-scanner",
  "version": "0.3.7",
  "description": "A lightweight and simple barcode/QR code scanner for React Native",
  "workspaces": [
    "example"
  ],
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./mocks": {
      "source": "./src/mocks/jest.ts",
      "types": "./src/mocks/jest.ts",
      "default": "./src/mocks/jest.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "pnpm --filter react-native-simple-scanner-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "husky && bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:dependencies": "node --test scripts/check-dev-dependencies.cjs",
    "size-limit": "size-limit",
    "size-limit:check": "size-limit --json",
    "docs": "typedoc"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "barcode",
    "qr",
    "qrcode",
    "scanner"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bon-clevique/react-native-simple-scanner.git"
  },
  "author": "Clevique <bon@clevique.app> (https://github.com/bon-clevique)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bon-clevique/react-native-simple-scanner/issues"
  },
  "homepage": "https://github.com/bon-clevique/react-native-simple-scanner#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.84.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "react": "19.2.4",
    "react-native": "0.84.1",
    "react-native-builder-bob": "^0.44.1",
    "react-test-renderer": "19.2.4",
    "semantic-release": "25.0.9",
    "size-limit": "^11.2.0",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "SimpleScannerViewSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.simplescanner"
    },
    "ios": {
      "componentProvider": {
        "SimpleScannerView": "SimpleScannerView"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.56.0"
  },
  "size-limit": [
    {
      "path": "lib/module/index.js",
      "limit": "2 KB"
    }
  ],
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10"
  },
  "pnpm": {
    "overrides": {
      "eslint>ajv": "6.14.0",
      "@eslint/eslintrc>ajv": "6.14.0",
      "cosmiconfig>js-yaml": "4.3.2",
      "glob@>=9 <14.0.2": "14.0.2",
      "minimatch@>=10 <11.0.3": "11.0.3",
      "deepmerge@4.3.1": "npm:@stackline/deepmerge@1.1.0",
      "@react-native/dev-middleware>chromium-edge-launcher": "2.0.1",
      "babel-plugin-istanbul@6.1.1>test-exclude": "7.0.2",
      "fast-xml-parser": ">=5.3.6",
      "markdown-it": ">=14.1.1",
      "qs": ">=6.14.2"
    },
    "patchedDependencies": {
      "typedoc@0.28.20": "patches/typedoc@0.28.20.patch",
      "@react-native/dev-middleware@0.84.1": "patches/@react-native__dev-middleware@0.84.1.patch"
    }
  }
}
